.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/

# .llm_cache/ is deliberately NOT ignored. The model call is not a pure function,
# so the verdict cache is the only thing that makes the model-backed numbers
# reproduce. The paper and both READMEs call it a primary experimental artefact
# and it ships with the bundle. Adding it here would drop it from the record.

# The three cohort directories under data/ are about 500 MB of public corpora.
# They ship with the bundle on disk but are too large to commit, so they stay
# ignored here. The two files that document them are not ignored.
data/*
!data/README.md
!data/PROVENANCE.md
# The cohort digests MUST ship: they are what lets a reader prove they hold the
# same data. Without this line data/* swallows them and the reproducibility
# claim in REPRODUCE.md becomes uncheckable.
!data/COHORT_MANIFEST.json

# Process record, not an experimental result: wall-clock timestamps mean it is
# not byte-reproducible, and it is regenerated by `make audit`.
audit/
